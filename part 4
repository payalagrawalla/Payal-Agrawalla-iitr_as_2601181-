# 1. Least Autonomy Enforcement Demonstration
# Tools are assigned strictly per agent responsibility. Wiring 'check_order_status' to non-lookup agents is prohibited.
ALLOWED_AGENT_TOOLS = {
    "Retrieval Agent": ["Policy RAG Retrieval Tool"],
    "Lookup Agent": ["Order Status Lookup Tool"],
    "Response Composer": []  # Strictly zero tools
}

def enforce_least_autonomy(agent_role: str, tool_name: str) -> bool:
    """Guards against agents calling unauthorized tools."""
    allowed = tool_name in ALLOWED_AGENT_TOOLS.get(agent_role, [])
    if not allowed:
        print(f"🚫 [GOVERNANCE BLOCKED]: Agent '{agent_role}' attempted unauthorized call to tool '{tool_name}'.")
    return allowed


# 2. Runtime Token / Cost-Budget Cap
MAX_REQUEST_TOKEN_CAP = 1000  # Token limit per single request

def process_request_with_budget_cap(query: str, estimated_tokens: int) -> Dict[str, Any]:
    """Enforces runtime budget cap and rejects oversized requests."""
    if estimated_tokens > MAX_REQUEST_TOKEN_CAP:
        return {
            "status": "REJECTED",
            "error": f"Request rejected: Estimated tokens ({estimated_tokens}) exceed budget cap ({MAX_REQUEST_TOKEN_CAP})."
        }
    return {"status": "ACCEPTED", "message": "Request within token budget limits."}


# ---------------------------------------------------------------------------
# Task 16: Normalized Response Caching
# ---------------------------------------------------------------------------

class ResponseCache:
    """In-memory cache keyed by normalized query text."""
    
    def __init__(self):
        self._cache: Dict[str, str] = {}
        self.call_count: int = 0

    def _normalize(self, query: str) -> str:
        return " ".join(query.lower().strip().split())

    def get_or_compute(self, query: str) -> Dict[str, Any]:
        key = hashlib.md5(self._normalize(query).encode("utf-8")).hexdigest()
        
        if key in self._cache:
            return {"hit": True, "response": self._cache[key]}
        
        # Simulate LLM/Tool execution overhead
        self.call_count += 1
        time.sleep(0.05)
        response = f"Grounded response for query: '{query}'"
        self._cache[key] = response
        
        return {"hit": False, "response": response}


