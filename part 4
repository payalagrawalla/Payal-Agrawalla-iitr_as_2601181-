class ReviewVerdict(BaseModel):
    """Structured verdict model returned by the AutoGen review team."""
    approved: bool = Field(..., description="True if draft is accurate and compliant.")
    final_answer: str = Field(..., description="The approved draft or revised output.")
    reason: str = Field(..., description="Explanation of approval or revision rationale.")


class MockAutoGenReviewTeam:
    """
    Simulates a 2-agent AutoGen Round Robin Group Chat team (Policy-Compliance-Reviewer 
    and Final-Editor) returning structured ReviewVerdict outputs.
    """
    
    @classmethod
    def review_draft(cls, retrieved_context: str, draft_answer: str) -> ReviewVerdict:
        # Check for ungrounded hallucinated claims in the draft
        if "guaranteed 24-hour instant cash refund" in draft_answer.lower():
            return ReviewVerdict(
                approved=False,
                final_answer=(
                    "Nykaa allows returns within 15 days for unopened cosmetics. "
                    "COD refunds are processed via bank transfer within 5 to 7 business days "
                    "following quality verification."
                ),
                reason="Caught ungrounded claim ('guaranteed 24-hour instant cash refund'). Revised to match policy SLA of 5-7 business days."
            )
        
        return ReviewVerdict(
            approved=True,
            final_answer=draft_answer,
            reason="Draft fully accurate and compliant with retrieved policy documents."
        )


