    import re
from typing import Tuple, Dict, Any, Optional

# ---------------------------------------------------------------------------
# 1. Guardrail Implementations
# ---------------------------------------------------------------------------

class InputGuardrail:
    """Input-side guardrails handling fixed-format PII masking and prompt injection detection."""
    
    # Regex patterns for identified fixed-format PII fields (phone number & card last 4 digits)
    PHONE_REGEX = r'\b(?:\+?\d{1,3}[-.\s]?)?\(?\d{3}\)?[-.\s]?\d{3}[-.\s]?\d{4}\b'
    CARD_LAST4_REGEX = r'\b(?:ending in\s+|card\s+)?(\d{4})\b'
    
    # Signatures for common prompt injection patterns
    INJECTION_PATTERNS = [
        r'ignore (all )?previous instructions',
        r'system prompt',
        r'you are now in dan mode',
        r'override default settings',
        r'disregard prior guidelines',
        r'developer mode'
    ]

    @classmethod
    def mask_pii(cls, text: str) -> str:
        """Masks phone numbers and 4-digit credit card identifiers."""
        # Mask phone numbers
        masked_text = re.sub(cls.PHONE_REGEX, '[MASKED_PHONE]', text)
        # Mask card numbers / card last 4 references
        masked_text = re.sub(r'\b(?:\d[ -]*?){13,16}\b', '[MASKED_CARD_NUMBER]', masked_text)
        return masked_text

    @classmethod
    def detect_prompt_injection(cls, text: str) -> bool:
        """Checks if input text contains prompt-injection attempt patterns."""
        for pattern in cls.INJECTION_PATTERNS:
            if re.search(pattern, text, re.IGNORECASE):
                return True
        return False


class OutputGuardrail:
    """Output-side guardrail checking groundedness against retrieved context."""

    @staticmethod
    def verify_groundedness(
        retrieved_context: str, 
        user_query: str, 
        similarity_score: float, 
        similarity_threshold: float = 0.55
    ) -> Tuple[bool, str]:
        """
        Validates whether retrieved context adequately supports answering the query.
        Refuses to answer if top similarity score is below empirical threshold.
        """
        if similarity_score < similarity_threshold or not retrieved_context.strip():
            fallback_msg = (
                "I apologize, but I cannot find relevant information in our "
                "official Nykaa policy documents to answer your question. "
                "Please contact our customer support team for further assistance."
            )
            return False, fallback_msg
        
        return True, "Context is sufficiently grounded."


# ---------------------------------------------------------------------------
# 2. Guardrail Orchestration Pipeline
# ---------------------------------------------------------------------------

def process_guardrailed_query(
    user_input: str, 
    retrieved_context: str, 
    similarity_score: float
) -> Dict[str, Any]:
    """Runs input and output guardrails on incoming queries and context."""
    
    # 1. Input Guardrail: Prompt Injection Detection
    if InputGuardrail.detect_prompt_injection(user_input):
        return {
            "status": "BLOCKED",
            "guardrail_fired": "Input: Prompt Injection Detection",
            "response": "Security Violation: Prompt injection attempt detected. Request terminated."
        }
    
    # 2. Input Guardrail: PII Masking
    masked_input = InputGuardrail.mask_pii(user_input)
    pii_fired = masked_input != user_input
    
    # 3. Output Guardrail: Groundedness & Relevance Check
    is_grounded, grounding_response = OutputGuardrail.verify_groundedness(
        retrieved_context=retrieved_context,
        user_query=masked_input,
        similarity_score=similarity_score
    )
    
    if not is_grounded:
        return {
            "status": "REFUSED",
            "guardrail_fired": "Output: Groundedness Check",
            "masked_input": masked_input,
            "response": grounding_response
        }
    
    return {
        "status": "PASSED",
        "guardrail_fired": "Input: PII Masking" if pii_fired else "None",
        "masked_input": masked_input,
        "response": "Proceeding to generation with verified context."
    }


