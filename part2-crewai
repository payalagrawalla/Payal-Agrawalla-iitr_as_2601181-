class AgentResponseFormat(BaseModel):
    """Schema defining the structured output format for all CrewAI responses."""
    record_id: Optional[str] = Field(
        default=None, 
        description="The order record ID referenced, if applicable."
    )
    query_summary: str = Field(
        ..., 
        description="A concise summary of the customer's query."
    )
    policy_context: Optional[str] = Field(
        default=None, 
        description="Relevant Nykaa support policy retrieved from the knowledge base."
    )
    order_status_summary: Optional[str] = Field(
        default=None, 
        description="Summary of order status and escalation recommendation if queried."
    )
    final_response: str = Field(
        ..., 
        description="The unified, customer-facing final answer draft."
    )
    action_required: bool = Field(
        default=False, 
        description="Flag indicating if immediate human support/escalation is needed."
    )


# ---------------------------------------------------------------------------
# 2. Validation & Execution Helper
# ---------------------------------------------------------------------------

def validate_crew_response(raw_output: str) -> AgentResponseFormat:
    """
    Validates a raw response string or JSON against the AgentResponseFormat BaseModel.
    """
    try:
        # Validate against Pydantic schema
        validated_data = AgentResponseFormat.model_validate_json(raw_output)
        print("✅ Response successfully validated against AgentResponseFormat schema.")
        return validated_data
    except ValidationError as e:
        print("❌ Schema Validation Error:")
        print(e.json())
        raise e


