# 1. Global store for in-process session memory
store = {}

def get_session_history(session_id: str) -> InMemoryChatMessageHistory:
    """Retrieves or creates an in-memory chat history for a given session ID."""
    if session_id not in store:
        store[session_id] = InMemoryChatMessageHistory()
    return store[session_id]

# 2. Define prompt template accepting conversation history
prompt = ChatPromptTemplate.from_messages([
    ("system", "You are a helpful Nykaa e-commerce support agent."),
    MessagesPlaceholder(variable_name="history"),
    ("human", "{input}"),
])

# 3. Create mock runnable chain (simulating LLM response based on history)
def mock_llm_chain(inputs: dict) -> str:
    user_input = inputs["input"]
    history = inputs.get("history", [])
    
    # Check if context was carried over from previous turns
    has_prior_context = any("NYK-982341" in getattr(msg, "content", str(msg)) for msg in history)
    
    if "NYK-982341" in user_input:
        return "I have retrieved details for order NYK-982341. It contains cosmetics shipped on Tuesday."
    elif "where is my order" in user_input.lower() or "status" in user_input.lower():
        if has_prior_context:
            return "Regarding your previously mentioned order NYK-982341, it is currently in transit and scheduled for delivery tomorrow."
        return "Could you please provide your order ID so I can look up the status?"
    return f"How else can I assist you regarding {user_input}?"

# Wrap chain with session-based memory
