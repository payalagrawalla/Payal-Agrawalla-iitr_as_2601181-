from dataset import ORDERS  # ORDERS is a list of dicts generated in Task 1

def check_order_status(record_id: str) -> dict:
    """
    Looks up an order by record_id and returns its status, order_value_inr,
    and a calculated escalation_score in [0, 1].
    """
    # Find the order in the dataset
    order = next((o for o in ORDERS if o["record_id"] == record_id), None)
    
    if not order:
        raise ValueError(f"Order ID '{record_id}' not found.")
    
    # Calculate components
    delayed_flag = 1.0 if order["delayed_shipment"] else 0.0
    normalized_recency = min(max(order["days_since_created"] / 30.0, 0.0), 1.0)
    
    # Compute combined escalation score in [0, 1]
    escalation_score = round(0.6 * delayed_flag + 0.4 * normalized_recency, 4)
    
    return {
        "record_id": order["record_id"],
        "status": order["status"],
        "order_value_inr": order["order_value_inr"],
        "escalation_score": escalation_score,
        "recommend_escalation": escalation_score >= 0.50
    }
