# ---------------------------------------------------------------------------
# 3. WebSocket Endpoint for Real-Time Multi-Turn Chat
# ---------------------------------------------------------------------------

class ConnectionManager:
    """Manages active WebSocket client connections."""
    def __init__(self):
        self.active_connections: List[WebSocket] = []

    async def connect(self, websocket: WebSocket):
        await websocket.accept()
        self.active_connections.append(websocket)

    def disconnect(self, websocket: WebSocket):
        if websocket in self.active_connections:
            self.active_connections.remove(websocket)

    async def send_personal_message(self, message: str, websocket: WebSocket):
        await websocket.send_text(message)

manager = ConnectionManager()

@app.websocket("/ws/chat")
async def websocket_chat_endpoint(websocket: WebSocket):
    """
    WebSocket endpoint supporting real-time, multi-turn conversation history.
    Gracefully handles client disconnections via WebSocketDisconnect without crashing the server.
    """
    await manager.connect(websocket)
    session_history = []
    
    try:
        await manager.send_personal_message(
            json.dumps({"sender": "System", "message": "Connected to Nykaa Live Chat Agent."}), 
            websocket
        )
        
        while True:
            # Receive text frame from client
            raw_data = await websocket.receive_text()
            data = json.loads(raw_data)
            user_msg = data.get("message", "")
            
            # Record turn in session memory
            session_history.append({"user": user_msg})
            
            # Simulated Agent Orchestration / Response Generation
            agent_reply = f"Re: '{user_msg}' — I've checked our policies. Is there anything else about your order I can help with?"
            session_history.append({"agent": agent_reply})
            
            # Stream response back to client
            response_payload = {
                "sender": "Agent",
                "message": agent_reply,
                "turns_count": len(session_history) // 2
            }
            await manager.send_personal_message(json.dumps(response_payload), websocket)

    except WebSocketDisconnect:
        # Cleanly catch client disconnections to keep server running for other active clients
        manager.disconnect(websocket)
        logging.info("WebSocket client disconnected gracefully. Server running normally.")
        
    except Exception as e:
        # Handle unexpected protocol errors
        manager.disconnect(websocket)
        logging.error(f"Unexpected WebSocket error: {e}")
        
